#!/bin/sh

set -e

xzcat gmp-6.3.0.tar.xz | tar -xf -
cd gmp-6.3.0
sed \
  -e 's/\(gmp_compile="$cc .*conftest.c\)/\1 $LIBS/g' \
  -e 's/\(gmp_compile="$CC .*conftest.c\)/\1 $LIBS/g' \
  configure > configure.tmp
mv configure.tmp configure

cc_maybe_gcc()
{
    $1 -dM -E - </dev/null | grep -Eq '^#define __GNUC__ ([4-9]$|[1-9][0-9]+$)'
}

cc_is_clang()
{
    $1 -dM -E - </dev/null | grep -Eq '^#define __clang__ 1$'
}

cc_is_gcc()
{
    cc_maybe_gcc $1 && ! cc_is_clang $1
}

cc_version=$($1 -dumpversion)
cc_major=$(echo "$cc_version" | cut -d '.' -f 1)
if [ -z "$cc_major" ]; then
    die "Impossible to recognize the version of cc: ${cc_version}"
fi
if cc_is_gcc $1; then
    if [ "$cc_major" -ge 15 ]; then
        patch -p1 configure ../gcc.15.patch
    fi
fi

chmod +x configure

if [ "$5" = "false" ]; then
    SHARED_LIBRARY_ARG="--disable-shared"
fi

# $1 => c_compiler
# $2 => host
# $3 => target
# $4 => ocamlc_cflags
# $5 => supports_shared_libraries
# $6 => native_c_libraries

# When cross-compiling, configure looks for binutils named after the
# canonical target triple (e.g. aarch64-unknown-none-ranlib) and falls back
# to the host's own if there are none. The host's are wrong on hosts whose
# binutils do not handle the target's object format (macOS, for ELF), so use
# the tools named like the C compiler instead (e.g. aarch64-solo5-ocaml-gcc
# comes with aarch64-solo5-ocaml-ranlib), when they exist.
case "$1" in
  *-gcc|*-cc)
    tool_prefix="${1%cc}"
    tool_prefix="${tool_prefix%g}"
    if command -v "${tool_prefix}ranlib" > /dev/null 2>&1; then
      export AR="${tool_prefix}ar" RANLIB="${tool_prefix}ranlib" \
        NM="${tool_prefix}nm" STRIP="${tool_prefix}strip"
    fi
    ;;
esac

# On macOS, leave room to rewrite the shared library's install name below.
if [ "$5" = "true" ] && [ "$(uname -s)" = "Darwin" ]; then
  export LDFLAGS="${LDFLAGS:-} -Wl,-headerpad_max_install_names"
fi

ac_cv_func_obstack_vprintf=no \
ac_cv_func_localeconv=no \
./configure --host="$3" --build="$2" ABI=64 CC="$1" CPPFLAGS="$4" LIBS="$6" $SHARED_LIBRARY_ARG

make SUBDIRS="mpn mpz mpq mpf"\
    -j%{jobs}% \
    PRINTF_OBJECTS= SCANF_OBJECTS= \
    CFLAGS+="-Werror=implicit-function-declaration" CPPFLAGS="$4"

cp gmp.h ..
cp .libs/libgmp.a ..
if [ "$5" = "true" ]; then
    # on OpenBSD the symlink libgmp.so does not exist by default for some reason
    libgmp=.libs/libgmp.so
    for f in .libs/libgmp.so.* ; do
      if ! test -L "$f" ; then
        libgmp=$f
        break
      fi
    done
    # depending on if the host is macos or not
    if ! cp "$libgmp" ../dllgmp.so 2>/dev/null; then
      cp .libs/libgmp.dylib ../dllgmp.so
      # The dylib's install name is the configure prefix (/usr/local/lib),
      # where nothing will be installed. Point it at the file itself, so
      # that executables linked against it during the build (such as
      # generators run as build steps) can load it.
      install_name_tool -id "$(cd .. && pwd)/dllgmp.so" ../dllgmp.so
    fi
else
    touch ../dllgmp.so
fi
